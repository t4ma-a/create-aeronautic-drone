function pid(plus,minus,integ,last_otkol)
local posss = plus - minus
local otkol = target - posss
print("pos:" ,posss)
integ = integ + otkol
integ = math.max(-5, math.min(5, integ))
local spesd = otkol - last_otkol
last_otkol = otkol
local signal = (otkol * Kp) + (integ * Ki) + (spesd * Kd)
return signal,integ, last_otkol
end
